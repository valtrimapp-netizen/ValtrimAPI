NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://tu-dominio.com
DATABASE_URL=postgres://user:password@host:5432/valtrim
DB_SSL_ENABLED=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_HEALTH_TIMEOUT_MS=3000
DB_REQUIRED=true
JWT_ISSUER=valtrim-api
JWT_AUDIENCE=valtrim-web
JWT_ACCESS_SECRET=REEMPLAZAR_CON_SECRETO_LARGO
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
VISION_OWNER=node
SPIKE_ROOT=/app/spike
PYTHON_EXECUTABLE=python
HYBRID_EXTRACTOR_SCRIPT=/app/spike/src/hybrid_extract_from_pdf.py
STORAGE_ROOT=/app/storage
