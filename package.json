{
  "name": "valtrim-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=.env src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "migrate": "node scripts/run-migrations.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "supertest": "^7.2.2",
    "vitest": "^4.1.6"
  }
}